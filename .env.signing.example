# Copy to .env.signing (gitignored). Most people only need the profile name.

# Keychain profile from: xcrun notarytool store-credentials "notary-profile" ...
NOTARY_PROFILE=notary-profile

# Must match `security find-identity -v -p codesigning`
APPLE_SIGNING_IDENTITY=Developer ID Application: Your Name Or Company (TEAMIDHERE)
APPLE_TEAM_ID=TEAMIDHERE

# Only if you are NOT using a keychain profile (discouraged for local use):
# APPLE_ID=you@example.com
# APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
